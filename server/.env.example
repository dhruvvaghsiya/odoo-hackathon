# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=globetrotter

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting ───────────────────────────────────
# Auth endpoints (signup/login): stricter limits
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=15

# General API: broader limits
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100
