{
  "name": "globetrotter-server",
  "version": "1.0.0",
  "description": "GlobeTrotter backend API — Express + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:schema": "psql $DATABASE_URL -f database/schema.sql",
    "db:seed": "psql $DATABASE_URL -f database/seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed",
    "test:validation": "node tests/trip-stop-validation.test.js"
  },
  "keywords": [
    "globetrotter",
    "express",
    "postgresql",
    "api"
  ],
  "author": "GlobeTrotter Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
